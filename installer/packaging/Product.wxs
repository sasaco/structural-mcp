<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="structural-mcp $(var.ProductLabel)" Manufacturer="sasaco" Version="$(var.ProductVersion)"
           UpgradeCode="E617F890-6A7D-4BDD-A752-7AC3E7759B28" Scope="perUser" Compressed="yes" Language="1033">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer structural-mcp version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64" Message="structural-mcp requires 64-bit Windows." />
    <Property Id="ARPCOMMENTS" Value="Local structural MCP server. Run Setup and register Codex from the Start menu after installing." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sasaco/structural-mcp" />
    <!-- /f repairs ignore command-line properties. Restore this version's location before costing. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="REMEMBEREDINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="FindInstallFolder" Root="HKCU" Bitness="always64"
                      Key="Software\sasaco\structural-mcp\Installer\$(var.InstallVersion)" Name="InstallFolder" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[REMEMBEREDINSTALLFOLDER]" After="AppSearch" Sequence="both"
                 Condition="REMEMBEREDINSTALLFOLDER AND (Installed OR NOT INSTALLFOLDER)" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />
    <!-- Only this install's managed block is removed; config errors do not block file removal. -->
    <CustomAction Id="UnregisterOwnedCodex" FileRef="Ff786a1f4a92c5b222ec2ae920d599518"
                  ExeCommand="&quot;[INSTALLFOLDER]launcher.mjs&quot; unregister-codex --quiet" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterOwnedCodex" Before="RemoveFiles" Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="StructuralMcpFolder" Name="structural-mcp">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallVersion)">
            <!-- WiX derives a stable GUID from the version-specific registry key path. -->
            <Component Id="RememberInstallFolder" Guid="*" Bitness="always64">
              <RegistryValue Root="HKCU" Key="Software\sasaco\structural-mcp\Installer\$(var.InstallVersion)"
                             Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="structural-mcp">
        <Component Id="StartMenuShortcuts" Guid="A2419F9A-AB3F-4548-80CD-321B43F26FAD">
          <Shortcut Id="SetupShortcut" Name="1 - Setup and register Codex" Target="[INSTALLFOLDER]setup.cmd" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="HealthShortcut" Name="2 - Check structural-mcp" Target="[INSTALLFOLDER]health.cmd" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UnregisterShortcut" Name="3 - Unregister from Codex" Target="[INSTALLFOLDER]unregister-codex.cmd" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="ReadmeShortcut" Name="Read me" Target="[INSTALLFOLDER]INSTALLER-README.md" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RemoveFolder Id="RemoveApplicationParent" Directory="StructuralMcpFolder" On="uninstall" />
          <RemoveFolder Id="RemoveProgramsParent" Directory="ProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\sasaco\structural-mcp\Installer" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Complete" Title="structural-mcp" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="RememberInstallFolder" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
